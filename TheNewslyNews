async function weather(){

const city=document.getElementById("cityInput")
.value.trim();

const output=document.getElementById("weatherResult");

if(!city){

output.textContent="Enter a city first!";
return;

}

output.textContent="🔎 Finding weather...";

try{

const geo=await fetch(
`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`
).then(r=>r.json());

if(!geo.results?.length){

output.textContent="😭 City not found.";
return;

}

const p=geo.results[0];

const data=await fetch(
`https://api.open-meteo.com/v1/forecast?latitude=${p.latitude}&longitude=${p.longitude}&current=temperature_2m,weather_code`
).then(r=>r.json());

output.innerHTML=`

📍 <strong>${p.name}</strong><br><br>

🌡️ ${data.current.temperature_2m}°C<br><br>

☁️ Weather code: ${data.current.weather_code}

`;

}catch(e){

output.textContent="Something went wrong.";

}

}


