["🌊 Oceans cover most of Earth's surface.",true],
["🐝 Bees can communicate through movement.",true],
["🦈 Sharks are younger than trees.",false]

];

let index=0;
let score=0;

showGame();

function next(){

if(index>=statements.length){

finishGame(`🃏 Fact or Fake complete!<br><br>
Score: ${score}/${statements.length}`);

return;

}

const s=statements[index];

document.getElementById("gameArea").innerHTML=`

<div class="gameBox">

<div class="gameQuestion">
${s[0]}
</div>

<button class="answer" onclick="factAnswer(true)">
✅ FACT
</button>

<button class="answer" onclick="factAnswer(false)">
❌ FAKE
</button>

</div>`;

window.factData={statements,index,score,next};

}

window.factAnswer=function(answer){

const d=window.factData;

if(answer===d.statements[d.index][1]){
d.score++;
xp+=20;
}

d.index++;

saveData();
d.next();

};

next();

}


