<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>NEWSLY 📰</title>
<meta name="description" content="NEWSLY — news, facts, games and fun for curious minds.">

<style>
:root{
  --bg:#f4f6fb;
  --card:#fff;
  --text:#151a28;
  --muted:#687188;
  --line:#e2e6ef;
  --soft:#edf1f9;
  --accent:#ff3b30;
  --blue:#3867ff;
  --green:#19a974;
  --yellow:#ffc928;
  --shadow:0 12px 35px rgba(20,30,60,.08);
}

*{box-sizing:border-box}

html{scroll-behavior:smooth}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
}

body.dark{
  --bg:#0e1320;
  --card:#181e2c;
  --text:#f8f9ff;
  --muted:#aab2c4;
  --line:#2d3546;
  --soft:#242c3d;
  --shadow:0 12px 35px rgba(0,0,0,.25);
}

button,input{
  font:inherit;
}

button{
  cursor:pointer;
}

.topbar{
  background:var(--text);
  color:var(--bg);
  text-align:center;
  padding:8px 12px;
  font-size:12px;
  font-weight:800;
}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}

.dark header{
  background:rgba(24,30,44,.94);
}

.nav{
  max-width:1250px;
  margin:auto;
  padding:13px 16px;
  display:flex;
  align-items:center;
  gap:12px;
}

.logo{
  font-size:28px;
  font-weight:1000;
  letter-spacing:-1.5px;
  cursor:pointer;
  white-space:nowrap;
}

.logo span{
  color:var(--accent);
}

.search{
  flex:1;
  display:flex;
  background:var(--soft);
  border:1px solid var(--line);
  border-radius:14px;
  overflow:hidden;
}

.search input{
  flex:1;
  min-width:0;
  border:0;
  outline:0;
  padding:12px 14px;
  background:transparent;
  color:var(--text);
}

.search button{
  border:0;
  background:transparent;
  padding:0 15px;
}

.icon{
  border:0;
  background:var(--soft);
  color:var(--text);
  padding:11px 13px;
  border-radius:12px;
}

.categories{
  max-width:1250px;
  margin:auto;
  padding:0 16px 12px;
  display:flex;
  gap:8px;
  overflow-x:auto;
}

.categories button{
  border:0;
  background:var(--soft);
  color:var(--text);
  padding:9px 14px;
  border-radius:20px;
  white-space:nowrap;
}

.categories button:hover,
.categories button.active{
  background:var(--text);
  color:var(--bg);
}

main{
  max-width:1250px;
  margin:auto;
  padding:25px 16px 70px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.hero{
  padding:42px;
  border-radius:28px;
  background:linear-gradient(135deg,#dce7ff,#fff);
  box-shadow:var(--shadow);
  margin-bottom:22px;
}

.dark .hero{
  background:linear-gradient(135deg,#202f54,#1b2130);
}

.hero h1{
  font-size:clamp(45px,8vw,82px);
  line-height:.9;
  letter-spacing:-4px;
  margin:0 0 18px;
}

.hero p{
  max-width:700px;
  font-size:20px;
  line-height:1.5;
  color:var(--muted);
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:23px;
}

.primary,
.secondary{
  border:0;
  border-radius:12px;
  padding:12px 17px;
  font-weight:800;
}

.primary{
  background:var(--text);
  color:var(--bg);
}

.secondary{
  background:var(--soft);
  color:var(--text);
}

.breaking{
  background:var(--accent);
  color:white;
  border-radius:14px;
  padding:13px 15px;
  font-weight:800;
  margin-bottom:25px;
}

.notice{
  background:var(--soft);
  color:var(--muted);
  padding:13px;
  border-radius:13px;
  margin-bottom:25px;
  font-size:13px;
}

.title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:30px 0 14px;
}

.title h2{
  margin:0;
}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:17px;
}

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:21px;
  overflow:hidden;
  box-shadow:0 5px 20px rgba(20,30,60,.03);
  transition:.2s;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow);
}

.cardImage{
  height:175px;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:72px;
  background:var(--soft);
}

.cardBody{
  padding:18px;
}

.tag{
  display:inline-block;
  padding:6px 9px;
  border-radius:20px;
  background:var(--soft);
  font-size:11px;
  font-weight:900;
}

.card h3{
  font-size:21px;
  line-height:1.15;
  margin:11px 0 8px;
}

.card p{
  color:var(--muted);
  line-height:1.5;
}

.meta{
  color:var(--muted);
  font-size:12px;
}

.cardButtons{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.cardButtons button{
  flex:1;
  border:0;
  background:var(--soft);
  color:var(--text);
  padding:10px;
  border-radius:10px;
}

.article{
  max-width:900px;
  margin:auto;
}

.articleHero{
  background:var(--soft);
  border-radius:25px;
  min-height:260px;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:110px;
  margin-top:18px;
}

.article h1{
  font-size:clamp(38px,7vw,70px);
  line-height:1;
  letter-spacing:-3px;
}

.articleText{
  font-size:19px;
  line-height:1.8;
}

.explainBox{
  padding:23px;
  border-radius:20px;
  background:#fff1a8;
  color:#3c3300;
  margin:30px 0;
}

.dark .explainBox{
  background:#4b4419;
  color:#fff5ad;
}

.stats{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.stat{
  flex:1;
  min-width:130px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px;
  text-align:center;
}

.stat strong{
  display:block;
  font-size:28px;
}

.arcadeHero{
  background:linear-gradient(135deg,#1a1e31,#353e67);
  color:white;
  border-radius:28px;
  padding:35px;
  margin-bottom:20px;
}

.arcadeHero h1{
  font-size:clamp(40px,7vw,70px);
  margin:0;
  letter-spacing:-3px;
}

.arcadeHero p{
  color:#d7ddff;
  font-size:18px;
}

.gameGrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:17px;
}

.game{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:22px;
  padding:23px;
  transition:.2s;
}

.game:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow);
}

.gameIcon{
  font-size:45px;
}

.game h3{
  margin-bottom:7px;
}

.game p{
  color:var(--muted);
  line-height:1.5;
}

.game button{
  width:100%;
  border:0;
  border-radius:11px;
  padding:12px;
  background:var(--text);
  color:var(--bg);
  font-weight:800;
}

.gameBox{
  max-width:700px;
  margin:auto;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:25px;
  padding:25px;
  box-shadow:var(--shadow);
  text-align:center;
}

.answer{
  width:100%;
  margin:7px 0;
  border:0;
  padding:13px;
  border-radius:12px;
  background:var(--soft);
  color:var(--text);
  font-weight:700;
}

.answer:hover{
  transform:scale(1.01);
}

.gameQuestion{
  font-size:25px;
  line-height:1.3;
  font-weight:900;
  margin:20px 0;
}

.score{
  font-weight:900;
  font-size:18px;
}

.progress{
  height:10px;
  background:var(--soft);
  border-radius:20px;
  overflow:hidden;
}

.progress div{
  height:100%;
  width:0;
  background:var(--blue);
  transition:.3s;
}

.toolGrid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:17px;
}

.tool{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:21px;
  padding:22px;
}

.tool input{
  width:100%;
  padding:12px;
  border-radius:11px;
  border:1px solid var(--line);
  background:var(--soft);
  color:var(--text);
  margin:7px 0 10px;
}

.fact{
  font-size:20px;
  line-height:1.5;
}

.empty{
  padding:60px 20px;
  text-align:center;
  color:var(--muted);
}

footer{
  text-align:center;
  padding:45px 20px;
  background:var(--text);
  color:var(--bg);
}

@media(max-width:900px){
  .grid,
  .gameGrid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:650px){
  .nav{
    flex-wrap:wrap;
  }

  .search{
    flex-basis:100%;
    order:5;
  }

  .hero{
    padding:27px;
  }

  .grid,
  .gameGrid,
  .toolGrid{
    grid-template-columns:1fr;
  }

  .hero h1{
    letter-spacing:-2px;
  }
}
</style>
</head>


<body>

<div class="topbar">
⚡ NEWSLY • NEWS • FACTS • GAMES • FUN
</div>


<header>

<div class="nav">

<div class="logo" onclick="home()">
<span>NEWS</span>LY 📰
</div>

<div class="search">
<input
id="searchInput"
placeholder="Search Newsly..."
onkeydown="if(event.key==='Enter')searchNews()">
<button onclick="searchNews()">🔎</button>
</div>

<button class="icon" onclick="showSaved()">❤️</button>

<button class="icon" onclick="toggleDark()">🌙</button>

</div>


<div class="categories">

<button class="active" onclick="home()">🏠 Home</button>
<button onclick="category('WOW')">🤯 WOW!</button>
<button onclick="category('Animals')">🐾 Animals</button>
<button onclick="category('Gaming')">🎮 Gaming</button>
<button onclick="category('Tech')">🤖 Tech</button>
<button onclick="category('Science')">🧪 Science</button>
<button onclick="category('World')">🌎 World</button>
<button onclick="category('Entertainment')">🎬 Entertainment</button>
<button onclick="category('Sport')">⚽ Sport</button>
<button onclick="showPage('arcadePage')">🎮 ARCADE</button>
<button onclick="showPage('funPage')">✨ FUN</button>

</div>

</header>


<main>


<!-- HOME -->

<section id="homePage" class="page active">

<div class="hero">

<h1>News.<br>But actually fun.</h1>

<p>
The place for curious minds to discover news,
amazing facts, weird stories, science, gaming,
animals, sport and loads more.
</p>

<div class="actions">

<button class="primary"
onclick="document.getElementById('stories').scrollIntoView()">
📰 Today's stories
</button>

<button class="secondary"
onclick="showPage('arcadePage')">
🎮 Play games
</button>

</div>

</div>


<div class="breaking">
🔴 NEWSLY • Welcome to your new favourite news site!
</div>


<div class="notice">
ℹ️ This version contains demonstration/educational stories.
For real current news, connect a legitimate news API and
credit the original sources.
</div>


<div class="title">
<h2>🔥 Trending on Newsly</h2>
</div>

<div id="trending" class="grid"></div>


<div id="stories" class="title">
<h2>📰 Today's Newsly</h2>
</div>

<div id="homeStories" class="grid"></div>


<div class="title">
<h2>🤯 Quick Fact</h2>
</div>

<div class="tool">

<div id="dailyFact" class="fact"></div>

<br>

<button class="primary" onclick="newFact()">
Another fact!
</button>

</div>


<div class="title">
<h2>🏆 Your Newsly Stats</h2>
</div>

<div class="stats">

<div class="stat">
<strong id="xp">0</strong>
XP
</div>

<div class="stat">
<strong id="streak">0</strong>
Day streak
</div>

<div class="stat">
<strong id="savedCount">0</strong>
Saved
</div>

</div>

</section>


<!-- CATEGORY -->

<section id="categoryPage" class="page">

<button class="secondary" onclick="home()">← Home</button>

<h1 id="categoryTitle"></h1>

<div id="categoryStories" class="grid"></div>

</section>


<!-- SEARCH -->

<section id="searchPage" class="page">

<button class="secondary" onclick="home()">← Home</button>

<h1>🔎 Search Newsly</h1>

<p id="searchText"></p>

<div id="searchResults" class="grid"></div>

</section>


<!-- ARTICLE -->

<section id="articlePage" class="page">

<div class="article">

<button class="secondary" onclick="home()">← Home</button>

<div id="articleContent"></div>

</div>

</section>


<!-- SAVED -->

<section id="savedPage" class="page">

<button class="secondary" onclick="home()">← Home</button>

<h1>❤️ Saved Stories</h1>

<div id="savedStories" class="grid"></div>

</section>


<!-- ARCADE -->

<section id="arcadePage" class="page">

<div class="arcadeHero">

<h1>🎮 NEWSLY ARCADE</h1>

<p>
Read it. Learn it. PLAY IT.
</p>

<div class="stats">

<div class="stat">
<strong id="arcadeXP">0</strong>
XP
</div>

<div class="stat">
<strong id="arcadeGames">0</strong>
Games played
</div>

</div>

</div>


<div id="gameMenu" class="gameGrid">

<div class="game">
<div class="gameIcon">🧠</div>
<h3>News Quiz</h3>
<p>Test your knowledge with multiple-choice questions.</p>
<button onclick="startQuiz()">PLAY</button>
</div>


<div class="game">
<div class="gameIcon">🃏</div>
<h3>Fact or Fake?</h3>
<p>Can you tell what's true?</p>
<button onclick="startFactGame()">PLAY</button>
</div>


<div class="game">
<div class="gameIcon">🔤</div>
<h3>Word Scramble</h3>
<p>Unscramble the Newsly word.</p>
<button onclick="startScramble()">PLAY</button>
</div>


<div class="game">
<div class="gameIcon">😀</div>
<h3>Emoji News</h3>
<p>Guess the topic from the emojis.</p>
<button onclick="startEmoji()">PLAY</button>
</div>


<div class="game">
<div class="gameIcon">⚡</div>
<h3>Speed Round</h3>
<p>Answer as quickly as you can.</p>
<button onclick="startSpeed()">PLAY</button>
</div>


<div class="game">
<div class="gameIcon">🏆</div>
<h3>Achievements</h3>
<p>See what you've unlocked.</p>
<button onclick="showAchievements()">OPEN</button>
</div>

</div>


<div id="gameArea"></div>

</section>


<!-- FUN -->

<section id="funPage" class="page">

<button class="secondary" onclick="home()">← Home</button>

<h1>✨ Newsly Fun Zone</h1>

<div class="toolGrid">


<div class="tool">

<h2>🌦️ Weather</h2>

<p>Check the current temperature for a city.</p>

<input id="cityInput" placeholder="Belfast">

<button class="primary" onclick="weather()">
Check weather
</button>

<p id="weatherResult"></p>

</div>


<div class="tool">

<h2>🧠 Explain It Simply</h2>

<p>Get a super-simple explanation.</p>

<input id="explainInput" placeholder="What is a black hole?">

<button class="primary" onclick="explain()">
Explain!
</button>

<p id="explainResult"></p>

</div>


<div class="tool">

<h2>🎲 Random Fact</h2>

<p id="randomFactOutput">
Press the button for a fact!
</p>

<button class="primary" onclick="randomFact()">
Surprise me!
</button>

</div>


<div class="tool">

<h2>📊 Newsly Poll</h2>

<p>What's your favourite section?</p>

<button class="answer" onclick="vote('WOW!')">🤯 WOW!</button>
<button class="answer" onclick="vote('Animals')">🐾 Animals</button>
<button class="answer" onclick="vote('Gaming')">🎮 Gaming</button>
<button class="answer" onclick="vote('Science')">🧪 Science</button>

<p id="voteResult"></p>

</div>

</div>

</section>

</main>


<footer>

<h2>📰 NEWSLY</h2>

<p>The news you'll actually want to read.</p>

<p>Made for curious minds. 🌎</p>

</footer>


